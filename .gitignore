# =============================================================================
# .gitignore — Mi Día (Ionic + Angular + Capacitor)
# =============================================================================

# ── Archivos temporales del sistema ──────────────────────────────────────────
*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
$RECYCLE.BIN/
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
log.txt
npm-debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── Node.js ───────────────────────────────────────────────────────────────────
/node_modules

# ── Variables de entorno y configuracion sensible ────────────────────────────
.env
.env.*
!.env.example

# ── Compilacion web (Ionic/Angular) ──────────────────────────────────────────
# El directorio www se regenera con 'npm run build'
/www
/dist
/tmp
/out-tsc
/bazel-out
/.sourcemaps
/.versions

# ── Angular ───────────────────────────────────────────────────────────────────
/.angular
/.angular/cache
.sass-cache/
/.nx
/.nx/cache
/coverage
/typings
/connect.lock
testem.log
/libpeerconnection.log

# ── Ionic ─────────────────────────────────────────────────────────────────────
/.ionic

# NOTA: Las carpetas 'android' e 'ios' generadas por Capacitor SE VERSIONAN
# para que el Mac pueda hacer 'cap sync ios' directamente desde el repo
# sin necesidad de 'cap add ios'. Solo se excluyen los artefactos de build.

# ── Android: artefactos de compilacion (NO toda la carpeta android/) ─────────
/android/.gradle
/android/app/build
/android/build
/android/captures
/android/.idea
/android/local.properties
*.apk
*.aab

# ── Xcode / iOS: artefactos de compilacion (NO toda la carpeta ios/) ─────────
/ios/App/Pods
/ios/App/DerivedData
/ios/App/*.xcworkspace/xcuserdata
/ios/App/*.xcodeproj/xcuserdata
/ios/App/*.xcodeproj/project.xcworkspace/xcuserdata
*.xcuserstate
UserInterfaceState.xcuserstate

# ── Certificados y claves de firma (NUNCA subir al repositorio) ──────────────
*.keystore
*.jks
*.p12
*.pfx
*.cer
*.pem
*.key
*.p8
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
ExportOptions.plist

# ── Firebase y servicios en la nube ──────────────────────────────────────────
google-services.json
GoogleService-Info.plist

# ── IDEs y editores ───────────────────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code (se versionan solo los ajustes del proyecto, no personales)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# ── Testing ───────────────────────────────────────────────────────────────────
/coverage

# ── Otros ─────────────────────────────────────────────────────────────────────
/platforms
/plugins
/.bazelrc.user
